<?xml version="1.0"?>
<!--
    Dashboard chart sections and chart overrides.

    Every preset declared in report_datasets.xml (MageOS_AdvancedReport or any other module)
    already is a chart: id = preset code, section = preset area, first dimension, sort metric (or first metric),
    line chart for a date dimension, top 10 horizontal bars otherwise. The <chart> elements below only refine the
    generated charts of the default presets (metrics, chart type, limit, section).

    Access to a chart = its own <acl resource> (if any)
                      + its section resources (when the chart <acl inherit> is true, the default)
                      + the root resource MageOS_DashboardChart::charts (when the section <acl inherit> is true)
                      + the ACL of the preset dataset in report_datasets.xml (module resource and core resource,
                        always: Advanced Report enforces it when the data is read).
    Charts whose preset does not exist (module disabled, no report attribute configured...) are skipped.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_DashboardChart:etc/dashboard_charts_file.xsd">
    <section id="sales" label="Sales" sortOrder="10">
        <acl resource="MageOS_DashboardChart::sales"/>
    </section>
    <chart id="sales_overview" type="line" size="full" compareTo="previous_period" sortOrder="10">
        <description>Net sales and orders per day, compared with the previous period.</description>
        <metric code="net_sales"/>
        <metric code="orders"/>
    </chart>
    <chart id="sales_by_payment_method" type="doughnut" sortOrder="20">
        <description>Share of net sales by payment method.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="sales_by_shipping_method" type="doughnut" sortOrder="30">
        <description>Share of net sales by shipping method.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="sales_by_shipping_country" type="horizontalBar" limit="10" sortOrder="40">
        <description>Top 10 shipping countries by net sales.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="sales_by_customer_group" type="doughnut" sortOrder="50">
        <description>Share of net sales by customer group.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="new_vs_returning" type="pie" sortOrder="60">
        <description>Orders from first-time buyers compared with returning customers.</description>
        <metric code="orders"/>
    </chart>
    <chart id="sales_by_hour" type="bar" limit="24" sortOrder="70">
        <description>Orders and net sales by hour of day.</description>
        <metric code="orders"/>
        <metric code="net_sales"/>
    </chart>
    <chart id="sales_by_weekday" type="bar" limit="7" sortOrder="80">
        <description>Orders and net sales by day of the week.</description>
        <metric code="orders"/>
        <metric code="net_sales"/>
    </chart>
    <chart id="coupon_performance" type="horizontalBar" limit="10" sortOrder="90">
        <description>Top 10 coupon codes by orders.</description>
        <metric code="orders"/>
        <metric code="discounts"/>
    </chart>

    <section id="catalog" label="Catalog" sortOrder="20">
        <acl resource="MageOS_DashboardChart::catalog"/>
    </section>
    <!-- product_performance, sales_by_category and sales_by_attribute read order items: the sales_items
         dataset also requires MageOS_AdvancedReport::sales and Magento_Sales::sales_order. -->
    <chart id="product_performance" type="horizontalBar" limit="10" sortOrder="10">
        <description>Top 10 products by net sales.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="sales_by_category" type="horizontalBar" limit="10" sortOrder="20">
        <description>Top 10 categories by net sales.</description>
        <metric code="net_sales"/>
        <metric code="units_sold"/>
    </chart>
    <chart id="sales_by_attribute" type="bar" limit="10" sortOrder="30">
        <description>Net sales by the first report attribute.</description>
        <metric code="net_sales"/>
    </chart>
    <chart id="stock_value" type="horizontalBar" limit="10" sortOrder="40">
        <description>Top 10 SKUs by stock value at cost and at retail price.</description>
        <metric code="stock_value_cost"/>
        <metric code="stock_value_retail"/>
        <dimension code="sku"/>
    </chart>
    <chart id="low_stock_coverage" type="horizontalBar" limit="10" sortOrder="50">
        <description>The 10 products closest to running out, in days of coverage.</description>
        <metric code="coverage_days"/>
    </chart>
    <chart id="dead_stock" type="horizontalBar" limit="10" sortOrder="60">
        <description>Top 10 unsold in-stock products by value tied up.</description>
        <metric code="stock_value_cost"/>
    </chart>
    <chart id="never_sold" type="horizontalBar" limit="10" sortOrder="70">
        <description>Top 10 never sold in-stock products by value tied up.</description>
        <metric code="stock_value_cost"/>
    </chart>

    <section id="customers" label="Customers" sortOrder="30">
        <acl resource="MageOS_DashboardChart::customers"/>
    </section>
    <chart id="customer_value" type="horizontalBar" limit="10" sortOrder="10">
        <description>Top 10 customers by total spent this year.</description>
        <metric code="total_spent"/>
    </chart>
    <chart id="new_customer_registrations" type="line" sortOrder="20">
        <description>New customer accounts per day, compared with the previous period.</description>
        <metric code="registrations"/>
    </chart>

    <chart id="cart_conversion" type="doughnut"/>
</config>
